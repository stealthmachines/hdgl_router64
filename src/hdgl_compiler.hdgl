# ============================================================================
# HDGL SELF-HOSTING COMPILER
# ============================================================================
#
# This IS the compiler. Written in HDGL. Compiled by itself.
#
# From hdgl_self_hosting_compiler.hdgl (original):
#   "This file IS the HDGL compiler."
#   "It compiles itself."
#   "All in pure HDGL. No C. No assembly. Just glyphs and rewrites."
#
# From PLAN.md:
#   HDGL Source -> Meta Compiler -> HDGL IR -> Firmware Compiler -> ASM -> Binary
#   The Meta Compiler is the thing that builds the compiler that builds firmware.
#   It is a rewrite engine: Node* transform(Node* n, Rule* r) { return apply(r, n); }
#
# This compiler:
#   1. Parses .hdgl source into an Omega graph
#   2. Applies emit rules to produce x86 assembly text
#   3. Writes the assembly to a .asm file
#   4. The assembly is assembled by nasm (the minimum external dependency)
#      (or: the compiler emits binary directly, eliminating nasm entirely)
#
# Self-hosting is achieved when this compiler can compile hdgl_firmware.hdgl
# without any external C compiler.
#
# ============================================================================


# ============================================================================
# COMPILER SELF-DEFINITION
# ============================================================================

glyph compiler_self
    id          = COMPILER_SELF
    class       = COMPILER
    state       = INIT
    cap         = { SELF_HOSTING, RECURSIVE, PARSE, EMIT }

    # The compiler IS an Omega node.
    # It applies transformation rules to the source graph.
    # When it applies those rules to itself: self-hosting.
end


# ============================================================================
# PARSER RULES
# ============================================================================
#
# The parser is a set of rewrite rules.
# Input: raw source text (stream of tokens)
# Output: Omega nodes linked into a graph
# No AST. The graph IS the parse result.
#

rule parse_comment
    pattern     = "#" REST_OF_LINE
    action      = DISCARD
end

rule parse_glyph
    pattern     = "glyph" IDENTIFIER NEWLINE ATTRIBUTES "end"
    action      = CREATE_OMEGA_NODE
    # Creates: Omega { identity=hash(IDENTIFIER), type=CLASS, state=INIT }
    # Links to parent if parent= attribute present
end

rule parse_rule
    pattern     = "rule" IDENTIFIER NEWLINE BODY "end"
    action      = CREATE_REWRITE_RULE
    # Creates: Rule { match=PATTERN, replace=TRANSFORM, emit=BODY }
end

rule parse_phase
    pattern     = "phase" IDENTIFIER NEWLINE BODY "end"
    action      = CREATE_PHASE_NODE
end

rule parse_recurse
    pattern     = "recurse" IDENTIFIER NEWLINE BODY "end"
    action      = CREATE_RECURSE_NODE
end

rule parse_mutate
    pattern     = "mutate" STATE_NAME
    action      = CREATE_MUTATE_NODE
end

rule parse_branch
    pattern     = "branch" IDENTIFIER IDENTIFIER
    action      = CREATE_BRANCH_NODE
end

rule parse_emit
    pattern     = "emit" NEWLINE X86_BODY "end"
    action      = CREATE_EMIT_NODE
end

rule parse_attribute
    pattern     = (ID | CLASS | STATE | CAP | PARENT | RULE | TRANSFORM) "=" VALUE
    action      = SET_NODE_ATTRIBUTE
end


# ============================================================================
# CODE GENERATION RULES
# ============================================================================
#
# Each glyph class maps to an x86 emit template.
# The emit template is itself a glyph (rewrite rule body).
# No separate code generator. The rules ARE the code generator.
#

rule codegen_root
    match       = omega_node CLASS_ROOT
    emit
        ; Root node initialization
        ; OMEGA_BASE = 0x100000
        ; Node 0 (ROOT): identity=0, type=0, state=DISCOVERED
        mov  edi, 0x100000
        mov  dword [edi], 0          ; identity
        mov  word  [edi+8], 0        ; type = ROOT
        mov  dword [edi+12], 1       ; state = DISCOVERED
    end
end

rule codegen_cpu
    match       = omega_node CLASS_CPU
    emit
        ; CPU discovery via CPUID transformation
        ; T_CPUID: Omega(CPU,INIT) -> Omega(CPU,EXECUTED)
        xor  eax, eax
        cpuid
        ; family/model/stepping
        mov  eax, 1
        cpuid
        ; state transitions encoded directly
        ; no function call, no layer - the transform IS the instruction sequence
    end
end

rule codegen_mem
    match       = omega_node CLASS_MEM
    emit
        ; Memory discovery via E820 transformation
        ; T_E820: Omega(MEM,INIT) -> Omega(MEM,READY)
        ; E820 results already at 0x4F8/0x500 from real-mode phase
        movzx ecx, word [0x4F8]
        xor   ebx, ebx
        mov   esi, 0x500
    end
end

rule codegen_io
    match       = omega_node CLASS_IO
    emit
        ; IO discovery via PCI_CONFIG_WALK transformation
        ; T_PCI: Omega(IO,INIT) -> Omega(IO,CONFIGURED) + children
        xor  ebx, ebx
        mov  edx, 0xCF8
    end
end

rule codegen_compiler
    match       = omega_node CLASS_COMPILER
    emit
        ; Compiler initialization
        ; Source is at 0x9000 (loaded by boot stub)
        ; Self-hosting: compiler reads this source and rewrites itself
        movzx eax, word [0x7FF0]
        test  eax, eax
    end
end

rule codegen_mutate
    match       = rewrite_node MUTATE STATE_X
    emit
        ; State mutation: advance Omega node
        ; Omega_n+1 = T_IDENTITY(Omega_n) with new state
        mov  dword [edi + 12], STATE_X
    end
end

rule codegen_recurse
    match       = rewrite_node RECURSE TARGET_NODE
    emit
        ; Recurse: apply rule to all children of TARGET_NODE
        mov  edi, [TARGET_NODE + child_offset]
        .recurse_loop:
            test edi, edi
            jz   .recurse_done
            call .apply_rules
            mov  edi, [edi + sibling_offset]
            jmp  .recurse_loop
        .recurse_done:
    end
end


# ============================================================================
# OPTIMIZER RULES
# ============================================================================
#
# From hdgl_self_hosting_compiler.hdgl (original):
#   constant_fold, dead_code_elim, inline_expand
#

rule constant_fold
    pattern     = "const" IDENTIFIER "=" NUMBER
    optimize    = EVALUATE_CONSTANT
    # Replace symbolic constant with its value at compile time
end

rule dead_code_elim
    pattern     = node state UNREACHABLE
    optimize    = REMOVE
    # Remove any node whose state can never be reached given current rules
end

rule inline_expand
    pattern     = "inline" IDENTIFIER
    optimize    = EXPAND
    # Replace reference with the full body of the referenced glyph
end

rule collapse_identity_transforms
    pattern     = TRANSFORM_IDENTITY applied_to NODE
    optimize    = IDENTITY_ELIM
    # T_IDENTITY(Omega) = Omega. Remove the no-op transform.
end


# ============================================================================
# EMIT BACKEND - TEXT OR BINARY
# ============================================================================
#
# Two emit modes:
#   text:   produces .asm suitable for nasm (bootstrap mode)
#   binary: produces .bin directly (self-hosting mode, no nasm)
#
# In binary mode, the compiler itself is the assembler.
# This eliminates the last external dependency.
#

glyph emit_backend
    id          = EMIT_BACKEND
    class       = CODEGEN
    state       = INIT
    cap         = { TEXT, BINARY }

    rule emit_text
        match   = mode TEXT
        action  = WRITE_NASM_ASSEMBLY
        # Output: .asm file, assembled by: nasm -f bin file.asm -o file.bin
    end

    rule emit_binary
        match   = mode BINARY
        action  = WRITE_BINARY_DIRECTLY
        # Output: .bin file, no external assembler needed
        # This is the self-hosting mode
        # The compiler encodes x86 opcodes directly
    end

end


# ============================================================================
# COMPILER MAIN LOOP
# ============================================================================
#
# The core loop from PLAN.md:
#   for(each node) { rule = lookup(node); rewrite(node, rule); emit(node); }
# Everything else is syntax.
#

glyph compiler_main
    parent      = compiler_self
    id          = COMPILER_MAIN
    class       = COMPILER
    state       = INIT
    cap         = { EXECUTE }

    entry compile
        # Phase 1: Read source
        phase read_source
            source      = argv[1]    # or SELF if compiling itself
            target      = omega:source_buffer
            advance     = DISCOVERED
        end

        # Phase 2: Parse - apply parse rules to source buffer
        phase parse
            recurse parse_rules
                apply_to source_buffer
                emit omega_graph
            end
            advance     = CONFIGURED
        end

        # Phase 3: Optimize - apply optimizer rules to omega_graph
        phase optimize
            recurse optimizer_rules
                apply_to omega_graph
            end
            advance     = READY
        end

        # Phase 4: Emit - apply codegen rules to omega_graph
        phase emit
            recurse codegen_rules
                apply_to omega_graph
                emit output_buffer
            end
            advance     = EXECUTED
        end

        # Phase 5: Write output
        phase write
            source      = output_buffer
            target      = argv[2]    # output file
            advance     = COMPLETED
        end
    end

end


# ============================================================================
# SELF-COMPILATION ENTRY POINT
# ============================================================================
#
# When the compiler compiles itself:
#   input  = hdgl_compiler.hdgl (this file)
#   output = hdgl_compiler.bin
#
# The output binary, when run, reads hdgl_firmware.hdgl and emits firmware.bin.
# That is the full self-hosting chain.
#

self_compile_loop
    input   = hdgl_compiler.hdgl
    output  = hdgl_compiler_v2.hdgl

    entry compile_self
        phase self_hosting
            execute compiler_self
                input  = hdgl_compiler.hdgl
                output = hdgl_compiler_v2.hdgl
            end
        end
    end

end

# ============================================================================
# END OF HDGL COMPILER
# ============================================================================
#
# Compile chain:
#   hdgl_compiler.hdgl   (this file)
#           ↓
#   hdgl_compiler.bin    (bootstrap host binary, from hdgl_runtime_v3.c)
#           ↓
#   hdgl_firmware.hdgl   (the firmware source)
#           ↓
#   firmware.bin         (the bootable image)
#           ↓
#   [boot]
#           ↓
#   hdgl_firmware.hdgl   (read from disk by running firmware)
#           ↓
#   hdgl_firmware_v2.bin (self-modified, written back to disk)
#
# ============================================================================
