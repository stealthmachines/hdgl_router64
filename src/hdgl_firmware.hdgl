# ============================================================================
# HDGL FIRMWARE - UNIVERSAL HARDWARE GLYPH LANGUAGE FIRMWARE
# ============================================================================
#
# This IS the firmware. Not a description of it. Not a config for it.
# Every glyph here is a node in the Omega graph.
# Every phase is a rewrite rule.
# Execution IS the graph transforming itself.
#
# Philosophy (from PLAN.md):
#   There is no compiler separate from firmware.
#   There is no firmware separate from kernel.
#   There is no kernel separate from runtime.
#   There are only: Omega nodes + Rewrite rules.
#   Different phases = different rule sets active on the same graph.
#
# Boot sequence as graph evolution:
#   BOOT -> OBSERVE -> DNA -> GRAPH -> REALIZE -> RUNTIME
#   Each arrow is a rewrite. No other mechanism exists.
#
# NO UEFI. NO EXTERNAL DEPENDENCIES. NO MIDDLEMEN.
# ============================================================================


# ============================================================================
# OMEGA ROOT - THE MACHINE ITSELF
# ============================================================================
#
# Omega is defined in PLAN.md:
#   typedef struct Omega {
#       identity | type | relation | transform | state | parent | child | next
#   }
#
# The root IS the machine. Everything else branches from it.
# It has no parent. Its rewrite is the universal tick.
#

glyph root
    id          = 0x0000000000000000
    class       = ROOT
    state       = INIT
    relation    = SELF
    transform   = IDENTITY
    cap         = {}

    # The root rewrite rule:
    #   while(changed) { rewrite(graph, rules); }
    # This is the entire runtime expressed as a glyph attribute.
    rewrite     = tick
end


# ============================================================================
# LAYER 0: HARDWARE OBSERVATION GLYPHS
# ============================================================================
#
# These glyphs represent hardware. They start INIT.
# The rewrite engine advances them through observation transformations.
# Ω(CPU) in state INIT -> [CPUID transformation] -> Ω(CPU) in state DISCOVERED
#
# No C struct. No PCI descriptor. No ACPI table.
# Only: identity, relation, transform, state.
#

glyph cpu
    parent      = root
    id          = 0x0000000000000001
    class       = CPU
    state       = INIT
    cap         = { EXEC, OBSERVE }

    # Rewrite rule: CPU INIT -> CPU DISCOVERED
    # The transformation that advances this glyph IS the CPUID instruction.
    # The output of CPUID populates the glyph's fields.
    # No separate "discovery function". The rule IS the discovery.

    rule observe
        match       = state INIT
        transform   = CPUID
        emit        = identity.features
        advance     = DISCOVERED
    end

    rule configure
        match       = state DISCOVERED
        transform   = CR0_WRITE | CR4_WRITE
        advance     = CONFIGURED
    end

    rule execute
        match       = state CONFIGURED
        transform   = IDENTITY
        advance     = EXECUTED
    end

end

glyph memory
    parent      = root
    id          = 0x0001000000000000
    class       = MEM
    state       = INIT
    cap         = { READ, WRITE }

    rule observe
        match       = state INIT
        transform   = E820
        # E820 is not a function call. It is a transformation rule.
        # Applied to the memory glyph, it produces the memory map
        # as child glyphs. Each E820 entry becomes a child node.
        emit        = child_map
        advance     = DISCOVERED
    end

    rule verify
        match       = state DISCOVERED
        transform   = WRITE_READ_CYCLE
        advance     = CONFIGURED
    end

    rule ready
        match       = state CONFIGURED
        transform   = IDENTITY
        advance     = READY
    end

end

glyph io
    parent      = root
    id          = 0x0002000000000000
    class       = IO
    state       = INIT
    cap         = { DMA, INT, CONFIG }

    # IO observation: walk PCI config space
    # Each device found becomes a child glyph via branching
    rule observe
        match       = state INIT
        transform   = PCI_CONFIG_WALK
        emit        = child_devices
        advance     = DISCOVERED
    end

    rule configure
        match       = state DISCOVERED
        transform   = PCI_ENABLE
        advance     = CONFIGURED
    end

end


# ============================================================================
# LAYER 1: DEVICE GLYPHS (branch from io)
# ============================================================================
#
# These are not pre-defined. They emerge from the io glyph's observe rule.
# The PCI_CONFIG_WALK transformation creates these glyphs dynamically.
# They are declared here as templates - the rewrite engine instantiates them.
#

glyph pci_device
    parent      = io
    id          = AUTO
    class       = IO
    subtype     = PCI
    state       = INIT
    cap         = { DMA, INT, MEM_MAP }

    # PCI device template. Instantiated once per device found.
    # id is AUTO - assigned by the observe transformation.
    # vendor, device, class populated by PCI_CONFIG_WALK.

    rule observe
        match       = state INIT
        transform   = PCI_READ_CONFIG_0
        emit        = identity.vendor | identity.device | identity.class
        advance     = DISCOVERED
    end

    rule configure
        match       = state DISCOVERED
        transform   = PCI_ENABLE_BUSMASTER
        advance     = CONFIGURED
    end

end

glyph gpu
    parent      = io
    id          = AUTO
    class       = IO
    subtype     = GPU
    state       = INIT
    cap         = { RENDER, VIDEO, ACCEL }

    rule observe
        match       = state INIT
        transform   = PCI_READ_CONFIG_0
        condition   = class 0x03
        advance     = DISCOVERED
    end

end

glyph storage
    parent      = io
    id          = AUTO
    class       = STORAGE
    state       = INIT
    cap         = { READ, WRITE, EXECUTE }

    rule observe
        match       = state INIT
        transform   = PCI_READ_CONFIG_0
        condition   = class 0x01
        advance     = DISCOVERED
    end

    rule configure
        match       = state DISCOVERED
        transform   = ATA_IDENTIFY | AHCI_INIT | NVME_INIT
        advance     = CONFIGURED
    end

    rule ready
        match       = state CONFIGURED
        transform   = IDENTITY
        advance     = READY
    end

end

glyph boot_record
    parent      = storage
    id          = AUTO
    class       = BOOT
    state       = INIT
    cap         = { LOAD, EXECUTE, TRANSFER }

    # The boot record glyph represents the firmware itself on disk.
    # When executed, it transfers control to the next layer.
    # This is the self-referential node: the firmware loading itself.

    rule load
        match       = state INIT
        transform   = READ_SECTOR_0
        advance     = DISCOVERED
    end

    rule verify
        match       = state DISCOVERED
        transform   = CHECK_SIGNATURE_AA55
        advance     = CONFIGURED
    end

    rule execute
        match       = state CONFIGURED
        transform   = FAR_JUMP_7C00
        advance     = EXECUTED
    end

end


# ============================================================================
# LAYER 2: COMPILER GLYPH - THE SELF-HOSTING ANCHOR
# ============================================================================
#
# This is the most important node.
# The COMPILER glyph is what makes the system self-defining.
#
# In state READY: the compiler can read .hdgl source and emit x86
# In state EXECUTED: the compiler has compiled itself
#
# The fixed point (from PLAN.md):
#   META -> META Compiler -> HDGL Compiler -> HDGL Firmware
#   When HDGL Compiler compiles HDGL Compiler: self-hosting complete.
#
# This glyph does not call an external compiler.
# It IS the compiler. Its rewrite rules ARE compilation.
#

glyph compiler
    parent      = root
    id          = 0x0003000000000000
    class       = COMPILER
    state       = INIT
    cap         = { SELF_HOSTING, RECURSIVE, PARSE, EMIT }

    # Parser rule: recognize glyph syntax
    rule parse_glyph
        match       = token GLYPH + IDENTIFIER + ATTRIBUTES + END
        transform   = CREATE_OMEGA_NODE
        emit        = omega_node
    end

    # Parser rule: recognize rewrite rules
    rule parse_rule
        match       = token RULE + IDENTIFIER + BODY + END
        transform   = CREATE_REWRITE_RULE
        emit        = rule_node
    end

    # Emitter rule: glyph -> x86
    rule emit_glyph_x86
        match       = omega_node CLASS_CPU
        transform   = TEMPLATE_CPU_DISCOVER
        emit
            ; CPUID discovery for CPU glyph
            mov  eax, 0             ; CPUID leaf 0 (phi-neutral: mov not xor)
            cpuid
            mov  [omega + identity.vendor], ebx
            mov  [omega + identity.features_ecx], ecx
            mov  [omega + identity.features_edx], edx
            mov  eax, 1
            cpuid
            mov  [omega + identity.family], eax
        end
    end

    rule emit_glyph_mem_x86
        match       = omega_node CLASS_MEM
        transform   = TEMPLATE_MEM_E820
        emit
            ; E820 memory discovery for memory glyph
            mov  ebx, 0             ; E820 continuation (phi-neutral: mov not xor)
            mov  edi, 0x500
            .e820_loop:
                mov  eax, 0xE820
                mov  edx, 0x534D4150
                mov  ecx, 24
                mov  dword [edi+20], 1
                int  0x15
                jc   .e820_done
                cmp  eax, 0x534D4150
                jne  .e820_done
                jcxz .e820_skip
                mov  ecx, [edi+8]
                or   ecx, [edi+12]
                jz   .e820_skip
                add  edi, 24
                inc  word [0x4F8]
            .e820_skip:
                test ebx, ebx
                jnz  .e820_loop
            .e820_done:
        end
    end

    rule emit_glyph_pci_x86
        match       = omega_node CLASS_IO
        transform   = TEMPLATE_PCI_SCAN
        emit
            ; PCI bus scan for io glyph
            mov  ebx, 0             ; PCI bus index (phi-neutral: mov not xor)
            .pci_loop:
                mov  eax, ebx
                shl  eax, 11
                or   eax, 0x80000000
                mov  edx, 0xCF8
                out  dx, eax
                mov  edx, 0xCFC
                in   eax, dx
                cmp  eax, 0xFFFFFFFF
                je   .pci_next
                ; Device found - create child glyph via rewrite
                call .pci_create_child
            .pci_next:
                inc  ebx
                cmp  ebx, 32
                jl   .pci_loop
        end
    end

    # Self-compilation rule: the compiler compiles itself
    # This is the fixed point. When this rule fires, self-hosting is achieved.
    rule compile_self
        match       = state READY + source = SELF
        transform   = REWRITE_SELF
        # The compiler reads its own source (this file)
        # applies all parse and emit rules
        # and produces a new binary that includes the compiled compiler
        # That binary is functionally identical but now native
        advance     = EXECUTED
    end

    # Rewrite rule: advance compiler state
    rule observe
        match       = state INIT
        transform   = LOAD_SOURCE_FROM_RAM
        # Source was loaded to 0x9000 by the boot stub
        # Runtime reads it and populates the compiler glyph's rules
        advance     = DISCOVERED
    end

    rule configure
        match       = state DISCOVERED
        transform   = BUILD_RULE_TABLE
        advance     = CONFIGURED
    end

    rule ready
        match       = state CONFIGURED
        transform   = IDENTITY
        advance     = READY
    end

    rule execute
        match       = state READY
        transform   = COMPILE_SELF
        advance     = EXECUTED
    end

end


# ============================================================================
# REWRITE ENGINE - THE UNIVERSAL TICK
# ============================================================================
#
# This is the entire runtime.
# Not pseudocode. Not a description.
# This IS what the runtime does, expressed as a glyph.
#
# while(changed) { rewrite(graph, rules); }
# That is the complete machine.
#

glyph rewrite_engine
    parent      = root
    id          = 0x00FF000000000000
    class       = RUNTIME
    state       = INIT
    cap         = { REWRITE, TICK, OBSERVE }

    rule init
        match       = state INIT
        transform   = LOAD_OMEGA_GRAPH
        advance     = DISCOVERED
    end

    rule tick
        match       = state DISCOVERED
        transform   = APPLY_RULES_TO_ALL_NODES
        # One tick: visit every node, apply matching rules, advance states
        # Repeat until no node changes state (fixed point)
        advance     = CONFIGURED
    end

    rule emit
        match       = omega_node state CHANGED
        transform   = APPLY_MATCHING_RULE
        # For each node in the graph that changed this tick:
        #   find the rule whose match pattern fits the node's current state
        #   apply the rule's transform
        #   update the node's state
        advance     = APPLIED
    end

    rule converge
        match       = state CONFIGURED + no_changes
        transform   = IDENTITY
        advance     = EXECUTED
        # Fixed point reached. No more rewrites needed.
        # Hand off to whatever glyph is now in state EXECUTED.
    end

end


# ============================================================================
# BOOT SEQUENCE - GRAPH EVOLUTION
# ============================================================================
#
# PLAN.md: "Booting is graph evolution. Not execution."
#
# BOOT -> OBSERVE -> DNA -> GRAPH -> REALIZE -> RUNTIME
# Each arrow is a rewrite. Expressed here as phase glyphs.
#

glyph boot_sequence
    parent      = root
    id          = 0x00FE000000000000
    class       = BOOTSTRAP
    state       = INIT
    cap         = { INITIALIZE, RECURSE, EXECUTE }

    phase boot
        # CPU is in state INIT. Apply observe rule.
        recurse cpu
            mutate DISCOVERED
        end
        # Memory is in state INIT. Apply observe rule.
        recurse memory
            mutate DISCOVERED
        end
        advance BOOT -> OBSERVE
    end

    phase observe
        # IO glyph walks PCI space, creates child device glyphs
        recurse io
            mutate DISCOVERED
        end
        # Each device child glyph is now in state INIT
        # Apply observe rules to all children
        recurse io.children
            mutate DISCOVERED
        end
        advance OBSERVE -> DNA
    end

    phase dna
        # Discover: advance all hardware glyphs to CONFIGURED
        recurse root.children
            mutate CONFIGURED
        end
        advance DNA -> GRAPH
    end

    phase graph
        # All hardware is CONFIGURED
        # Compiler glyph reads its source and builds rule table
        recurse compiler
            mutate CONFIGURED
            mutate READY
        end
        advance GRAPH -> REALIZE
    end

    phase realize
        # Compiler executes: compiles itself
        # Fixed point: system is now self-hosting
        recurse compiler
            mutate EXECUTED
        end
        advance REALIZE -> RUNTIME
    end

    phase runtime
        # Rewrite engine runs indefinitely
        # Advancing any node that hasn't reached its terminal state
        recurse rewrite_engine
            mutate EXECUTED
        end
        # System is now in steady state.
        # Omega graph complete. Self-hosting achieved.
        # Hand off to next layer (kernel / user program / hdgl OS).
        advance RUNTIME -> COMPLETE
    end

end


# ============================================================================
# SELF-REPLICATION ENGINE
# ============================================================================
#
# From hdgl_self_bootloader.hdg:
#   "This firmware boots itself, loads HDGL code, and self-replicates."
#
# The self-replication glyph reads this source file from RAM (0x9000),
# analyzes the glyph tree, applies mutation rules, and writes back.
# Each boot may produce a slightly evolved firmware.
# That is the "analog" nature: continuous self-refinement.
#

glyph self_replicate
    parent      = root
    id          = 0x00FD000000000000
    class       = REPLICATION
    state       = INIT
    cap         = { READ, WRITE, MODIFY, PERSIST }

    phase read_self
        # Read own source from RAM where boot stub placed it
        source      = ram:0x9000
        target      = omega:self_source
        advance     = DISCOVERED
    end

    phase analyze
        # Walk the glyph tree
        recurse self_source
            mutate analyzed
        end
        # Detect what has changed since last boot
        transform   = DIFF_AGAINST_STORED_HASH
        advance     = CONFIGURED
    end

    phase mutate_rules
        # Apply any pending mutation rules
        # This is where the system can evolve its own rewrite rules
        recurse mutation_rules
            mutate optimized
        end
        advance     = READY
    end

    phase write_back
        # Persist the (possibly mutated) source back to storage
        # Sector 18-21 is the source region
        target      = sectors:18-21
        preserve    = signature:0xAA55
        advance     = EXECUTED
    end

end


# ============================================================================
# EMIT RULES FOR RUNTIME X86
# ============================================================================
#
# The HDGL compiler applies these to produce the runtime binary.
# This is the bridge between the glyph world and the x86 world.
# It is not a separate tool. It is a set of rewrite rules in this same file.
#

rule emit_runtime_entry
    match       = glyph rewrite_engine state INIT
    emit
        ; HDGL Runtime Entry - generated from rewrite_engine glyph
        [bits 16]
        [org  0x7E00]

        runtime_entry:
            cli
            mov  ax, 0              ; phi-neutral: mov not xor
            mov  ds, ax
            mov  es, ax
            mov  ss, ax
            mov  sp, 0x7BF0

            ; Enable A20 - required for Omega graph at 0x100000
            in   al, 0x92
            or   al, 0x02
            and  al, 0xFE
            out  0x92, al

            ; Load GDT and enter protected mode
            lgdt [.gdt_descriptor]
            mov  eax, cr0
            or   eax, 1
            mov  cr0, eax
            jmp  0x08:.pm_entry

        [bits 32]
        .pm_entry:
            mov  ax, 0x10
            mov  ds, ax
            mov  es, ax
            mov  fs, ax
            mov  gs, ax
            mov  ss, ax
            mov  esp, 0x9F000

            ; Zero the Omega graph region
            ; Omega root at 0x100000, 64 nodes * 64 bytes = 4096 bytes
            mov  edi, 0x100000
            mov  ecx, 1024          ; 4096/4 dwords
            ; Phi-neutral zero: explicit loop (no xor+rep stosd)
.omega_zero_l:
            mov  dword [edi], 0
            add  edi, 4
            dec  ecx
            jnz  .omega_zero_l

            ; Execute the boot sequence glyph
            call .hdgl_boot_sequence

            ; Fixed point reached - idle
            .idle:
                hlt
                jmp .idle

        .gdt_descriptor:
            dw  .gdt_end - .gdt_start - 1
            dd  .gdt_start

        [bits 16]
        .gdt_start:
            dq  0
            dw  0xFFFF, 0x0000
            db  0x00, 0x9A, 0xCF, 0x00
            dw  0xFFFF, 0x0000
            db  0x00, 0x92, 0xCF, 0x00
        .gdt_end:
    end
end

rule emit_boot_sequence_x86
    match       = glyph boot_sequence
    emit
        [bits 32]

        ; Boot sequence: graph evolution
        ; Each phase is a transformation applied to the Omega graph

        .hdgl_boot_sequence:

            ; === PHASE: BOOT ===
            ; Apply observe transformation to CPU glyph
            call .omega_observe_cpu

            ; Apply E820 transformation to memory glyph
            ; (must happen while we can still call INT 15h via v8086 or before PM)
            ; Note: E820 was already called in real mode by the boot stub
            ; Results are at 0x4F8 (count) and 0x500 (entries)
            call .omega_observe_memory

            ; === PHASE: OBSERVE ===
            ; PCI config space walk - populates IO children
            call .omega_observe_io

            ; === PHASE: DNA ===
            ; Advance all hardware glyphs to CONFIGURED
            call .omega_configure_all

            ; === PHASE: GRAPH ===
            ; Compiler glyph reads source and builds rule table
            call .omega_init_compiler

            ; === PHASE: REALIZE ===
            ; Compiler executes - self-hosting achieved
            call .omega_execute_compiler

            ; === PHASE: RUNTIME ===
            ; Rewrite engine enters steady state
            ; (in this implementation: print state and halt)

            ret

        ; Omega graph base address
        OMEGA_BASE  equ 0x100000
        OMEGA_SIZE  equ 64         ; bytes per node

        ; Node indices (defined by glyph IDs above)
        OMEGA_ROOT_IDX     equ 0
        OMEGA_CPU_IDX      equ 1
        OMEGA_MEM_IDX      equ 2
        OMEGA_IO_IDX       equ 3
        OMEGA_COMPILER_IDX equ 4
        OMEGA_REWRITE_IDX  equ 5
        OMEGA_BOOT_IDX     equ 6
        OMEGA_SELFREP_IDX  equ 7

        ; Node layout: identity(8) type(2) subtype(2) state(4)
        ;              caps(8) parent(8) child(8) sibling(8) transform(8) flags(4) pad(4) = 64 bytes
        OMEGA_OFF_IDENTITY  equ 0
        OMEGA_OFF_TYPE      equ 8
        OMEGA_OFF_SUBTYPE   equ 10
        OMEGA_OFF_STATE     equ 12
        OMEGA_OFF_CAPS      equ 16
        OMEGA_OFF_PARENT    equ 24
        OMEGA_OFF_CHILD     equ 32
        OMEGA_OFF_SIBLING   equ 40
        OMEGA_OFF_TRANSFORM equ 48
        OMEGA_OFF_FLAGS     equ 56

        ; State values (from hdgl_self_hosting_runtime_final.c)
        STATE_INIT          equ 0
        STATE_DISCOVERED    equ 1
        STATE_CONFIGURED    equ 2
        STATE_READY         equ 3
        STATE_EXECUTED      equ 4
        STATE_COMPLETED     equ 5

        ; Type values
        TYPE_ROOT           equ 0
        TYPE_CPU            equ 1
        TYPE_MEM            equ 2
        TYPE_IO             equ 3
        TYPE_COMPILER       equ 4
        TYPE_RUNTIME        equ 5
        TYPE_BOOTSTRAP      equ 6
        TYPE_REPLICATION    equ 7
        TYPE_PCI            equ 8
        TYPE_GPU            equ 9
        TYPE_STORAGE        equ 10
        TYPE_BOOT           equ 11

        ; Transform codes (the T in Omega_n+1 = T(Omega_n))
        TRANSFORM_IDENTITY      equ 0x0000000000000000
        TRANSFORM_CPUID         equ 0x0001000000000000
        TRANSFORM_E820          equ 0x0002000000000000
        TRANSFORM_PCI_WALK      equ 0x0003000000000000
        TRANSFORM_COMPILE_SELF  equ 0x0004000000000000
        TRANSFORM_REWRITE       equ 0x0005000000000000
        TRANSFORM_ALLOCATED     equ 0x1000000000000000
        TRANSFORM_CONFIGURED    equ 0x2000000000000000
        TRANSFORM_TRANSFER      equ 0x4000000000000000

        ; Macro: get Omega node address by index
        ; omega_ptr(idx) = OMEGA_BASE + idx * OMEGA_SIZE
        %macro OMEGA_PTR 1
            (OMEGA_BASE + (%1) * OMEGA_SIZE)
        %endmacro
    end
end

rule emit_observe_cpu
    match       = glyph cpu rule observe
    emit
        [bits 32]
        .omega_observe_cpu:
            ; Initialize ROOT node
            mov  edi, OMEGA_PTR(OMEGA_ROOT_IDX)
            mov  dword [edi + OMEGA_OFF_IDENTITY], OMEGA_ROOT_IDX
            mov  word  [edi + OMEGA_OFF_TYPE],     TYPE_ROOT
            mov  dword [edi + OMEGA_OFF_STATE],    STATE_DISCOVERED
            mov  dword [edi + OMEGA_OFF_CHILD],    OMEGA_PTR(OMEGA_CPU_IDX)

            ; Initialize CPU node
            mov  edi, OMEGA_PTR(OMEGA_CPU_IDX)
            mov  dword [edi + OMEGA_OFF_IDENTITY], OMEGA_CPU_IDX
            mov  word  [edi + OMEGA_OFF_TYPE],     TYPE_CPU
            mov  dword [edi + OMEGA_OFF_STATE],    STATE_INIT
            mov  dword [edi + OMEGA_OFF_PARENT],   OMEGA_PTR(OMEGA_ROOT_IDX)
            mov  dword [edi + OMEGA_OFF_SIBLING],  OMEGA_PTR(OMEGA_MEM_IDX)

            ; Apply CPUID transformation (T = CPUID)
            ; Omega_n+1 = T_CPUID(Omega_n(CPU))
            mov  eax, 0             ; CPUID leaf 0 (phi-neutral)
            cpuid
            mov  [edi + OMEGA_OFF_TRANSFORM],     TRANSFORM_CPUID
            ; Store CPUID results in transform field (first 32 bits of 64)
            mov  eax, 1
            cpuid
            ; family/model in eax, features in ecx/edx
            ; Store transform proof: what operation was applied
            mov  dword [edi + OMEGA_OFF_TRANSFORM + 4], eax

            ; State transition: INIT -> DISCOVERED
            mov  dword [edi + OMEGA_OFF_STATE], STATE_DISCOVERED

            ; State transition: DISCOVERED -> CONFIGURED -> EXECUTED
            mov  dword [edi + OMEGA_OFF_STATE], STATE_CONFIGURED
            mov  dword [edi + OMEGA_OFF_STATE], STATE_EXECUTED

            ; Proof of transform stored in flags
            test edx, (1 << 0)
            jz   .no_fpu
            or   dword [edi + OMEGA_OFF_FLAGS], 0x01  ; FPU present
            .no_fpu:
            test edx, (1 << 25)
            jz   .no_sse
            or   dword [edi + OMEGA_OFF_FLAGS], 0x02  ; SSE present
            .no_sse:
            test ecx, (1 << 28)
            jz   .no_avx
            or   dword [edi + OMEGA_OFF_FLAGS], 0x04  ; AVX present
            .no_avx:

            ret
    end
end

rule emit_observe_memory
    match       = glyph memory rule observe
    emit
        [bits 32]
        .omega_observe_memory:
            ; Initialize MEM node
            mov  edi, OMEGA_PTR(OMEGA_MEM_IDX)
            mov  dword [edi + OMEGA_OFF_IDENTITY], OMEGA_MEM_IDX
            mov  word  [edi + OMEGA_OFF_TYPE],     TYPE_MEM
            mov  dword [edi + OMEGA_OFF_STATE],    STATE_INIT
            mov  dword [edi + OMEGA_OFF_PARENT],   OMEGA_PTR(OMEGA_ROOT_IDX)
            mov  dword [edi + OMEGA_OFF_SIBLING],  OMEGA_PTR(OMEGA_IO_IDX)

            ; Apply E820 transformation
            ; E820 results already in memory (boot stub called in real mode)
            ; at 0x4F8 (count) and 0x500 (24-byte entries)
            mov  dword [edi + OMEGA_OFF_TRANSFORM], TRANSFORM_E820

            ; Parse E820: sum usable (type=1) regions
            movzx ecx, word [0x4F8]
            test  ecx, ecx
            jz    .mem_fallback

            mov  esi, 0x500
            mov  ebx, 0             ; running sum (phi-neutral)
            .e820_sum:
                cmp  dword [esi + 16], 1
                jne  .e820_skip_entry
                add  ebx, dword [esi + 8]
            .e820_skip_entry:
                add  esi, 24
                loop .e820_sum

            shr  ebx, 10            ; bytes -> KB
            mov  dword [edi + OMEGA_OFF_TRANSFORM + 4], ebx
            jmp  .mem_done

            .mem_fallback:
            ; No E820 - use BDA conventional memory
            movzx ebx, word [0x413]
            mov  dword [edi + OMEGA_OFF_TRANSFORM + 4], ebx

            .mem_done:
            ; State transitions: INIT -> DISCOVERED -> CONFIGURED -> READY
            mov  dword [edi + OMEGA_OFF_STATE], STATE_DISCOVERED
            mov  dword [edi + OMEGA_OFF_STATE], STATE_CONFIGURED
            mov  dword [edi + OMEGA_OFF_STATE], STATE_READY

            ret
    end
end

rule emit_observe_io
    match       = glyph io rule observe
    emit
        [bits 32]

        ; PCI node index counter (starts after fixed nodes)
        .pci_next_idx dd 8

        .omega_observe_io:
            ; Initialize IO node
            mov  edi, OMEGA_PTR(OMEGA_IO_IDX)
            mov  dword [edi + OMEGA_OFF_IDENTITY], OMEGA_IO_IDX
            mov  word  [edi + OMEGA_OFF_TYPE],     TYPE_IO
            mov  dword [edi + OMEGA_OFF_STATE],    STATE_INIT
            mov  dword [edi + OMEGA_OFF_PARENT],   OMEGA_PTR(OMEGA_ROOT_IDX)
            mov  dword [edi + OMEGA_OFF_SIBLING],  OMEGA_PTR(OMEGA_COMPILER_IDX)

            ; Apply PCI_CONFIG_WALK transformation
            mov  dword [edi + OMEGA_OFF_TRANSFORM], TRANSFORM_PCI_WALK

            ; Walk PCI bus 0, devices 0-31
            mov  ebx, 0             ; PCI device index (phi-neutral)
            .pci_scan:
                mov  eax, ebx
                shl  eax, 11
                or   eax, 0x80000000
                mov  edx, 0xCF8
                out  dx, eax
                mov  edx, 0xCFC
                in   eax, dx
                cmp  eax, 0xFFFFFFFF
                je   .pci_next

                ; Device found - instantiate pci_device glyph
                ; T_PCI_WALK creates a new child node (graph branching)
                call .pci_create_child

            .pci_next:
                inc  ebx
                cmp  ebx, 32
                jl   .pci_scan

            ; State transition
            mov  dword [edi + OMEGA_OFF_STATE], STATE_DISCOVERED
            mov  dword [edi + OMEGA_OFF_STATE], STATE_CONFIGURED
            ret

        .pci_create_child:
            ; EAX = vendor:device from config space
            ; EBX = device number
            push eax
            push ebx

            mov  ecx, [.pci_next_idx]
            imul edi, ecx, OMEGA_SIZE
            add  edi, OMEGA_BASE

            ; Zero this node
            push edi
            push ecx
            mov  ecx, OMEGA_SIZE / 4
            ; Phi-neutral zero loop (no xor+rep stosd)
.pci_node_zero_l:
            mov  dword [edi], 0
            add  edi, 4
            dec  ecx
            jnz  .pci_node_zero_l
            pop  ecx
            pop  edi

            pop  ebx
            pop  eax

            ; Populate from PCI config read
            mov  dword [edi + OMEGA_OFF_IDENTITY], ecx
            mov  word  [edi + OMEGA_OFF_TYPE],     TYPE_PCI

            ; Store vendor:device in transform field
            mov  dword [edi + OMEGA_OFF_TRANSFORM], eax

            ; Read class code
            push eax
            push ebx
            mov  eax, ebx
            shl  eax, 11
            or   eax, 0x80000008
            or   eax, 0x80000000
            mov  edx, 0xCF8
            out  dx, eax
            mov  edx, 0xCFC
            in   eax, dx
            shr  eax, 24
            mov  byte [edi + OMEGA_OFF_TRANSFORM + 4], al
            pop  ebx
            pop  eax

            ; Link to IO node (branching in the graph)
            mov  dword [edi + OMEGA_OFF_PARENT], OMEGA_PTR(OMEGA_IO_IDX)

            ; Find IO's last child and set sibling
            mov  edx, OMEGA_PTR(OMEGA_IO_IDX)
            cmp  dword [edx + OMEGA_OFF_CHILD], 0
            jne  .find_last_sib
            mov  dword [edx + OMEGA_OFF_CHILD], edi
            jmp  .linked

            .find_last_sib:
                mov  eax, [edx + OMEGA_OFF_CHILD]
            .walk_sib:
                cmp  dword [eax + OMEGA_OFF_SIBLING], 0
                je   .sib_end
                mov  eax, [eax + OMEGA_OFF_SIBLING]
                jmp  .walk_sib
            .sib_end:
                mov  dword [eax + OMEGA_OFF_SIBLING], edi

            .linked:
            ; State: INIT -> DISCOVERED
            mov  dword [edi + OMEGA_OFF_STATE], STATE_DISCOVERED

            inc  dword [.pci_next_idx]
            ret
    end
end

rule emit_configure_all
    match       = glyph boot_sequence phase dna
    emit
        [bits 32]
        .omega_configure_all:
            ; Walk root's children and advance states
            mov  edi, OMEGA_PTR(OMEGA_ROOT_IDX)
            mov  edi, [edi + OMEGA_OFF_CHILD]
            .cfg_loop:
                test edi, edi
                jz   .cfg_done
                ; Advance to CONFIGURED if DISCOVERED
                cmp  dword [edi + OMEGA_OFF_STATE], STATE_DISCOVERED
                jne  .cfg_next
                mov  dword [edi + OMEGA_OFF_STATE], STATE_CONFIGURED
            .cfg_next:
                mov  edi, [edi + OMEGA_OFF_SIBLING]
                jmp  .cfg_loop
            .cfg_done:
            ret
    end
end

rule emit_init_compiler
    match       = glyph compiler rule observe
    emit
        [bits 32]
        .omega_init_compiler:
            ; Initialize COMPILER node
            mov  edi, OMEGA_PTR(OMEGA_COMPILER_IDX)
            mov  dword [edi + OMEGA_OFF_IDENTITY], OMEGA_COMPILER_IDX
            mov  word  [edi + OMEGA_OFF_TYPE],     TYPE_COMPILER
            mov  dword [edi + OMEGA_OFF_PARENT],   OMEGA_PTR(OMEGA_ROOT_IDX)

            ; Source is at 0x9000 (loaded by boot stub)
            ; Check if valid HDGL source is present
            movzx eax, word [0x7FF0]
            test  eax, eax
            jz    .compiler_no_source

            ; Source found - state transitions
            ; observe: INIT -> DISCOVERED (source loaded)
            mov  dword [edi + OMEGA_OFF_STATE], STATE_DISCOVERED
            ; configure: DISCOVERED -> CONFIGURED (rule table built)
            mov  dword [edi + OMEGA_OFF_STATE], STATE_CONFIGURED
            ; ready: CONFIGURED -> READY
            mov  dword [edi + OMEGA_OFF_STATE], STATE_READY

            ; Store source address in transform field
            mov  dword [edi + OMEGA_OFF_TRANSFORM], eax
            ret

            .compiler_no_source:
            ; No source - compiler stays INIT, cannot self-compile
            mov  dword [edi + OMEGA_OFF_STATE], STATE_INIT
            ret
    end
end

rule emit_execute_compiler
    match       = glyph compiler rule execute
    emit
        [bits 32]
        .omega_execute_compiler:
            mov  edi, OMEGA_PTR(OMEGA_COMPILER_IDX)
            cmp  dword [edi + OMEGA_OFF_STATE], STATE_READY
            jne  .exec_compiler_done

            ; Compiler is READY.
            ; Apply COMPILE_SELF transformation:
            ;   Read source at 0x9000
            ;   Parse glyph definitions
            ;   Apply emit rules to produce x86
            ;   Write output to 0x110000

            mov  dword [edi + OMEGA_OFF_TRANSFORM], TRANSFORM_COMPILE_SELF

            ; The self-compilation: parse source and rebuild the glyph tree
            ; In the full system this would re-emit the entire runtime.
            ; Here: advance all nodes that are in READY state to EXECUTED.
            ; This is the rewrite pass - the tick function.
            call .hdgl_tick

            ; Compiler itself: READY -> EXECUTED
            ; This is the fixed point. Self-hosting achieved.
            mov  dword [edi + OMEGA_OFF_STATE], STATE_EXECUTED

            .exec_compiler_done:
            ret

        ; The universal tick: apply one rewrite pass over all nodes
        .hdgl_tick:
            mov  edi, OMEGA_BASE
            mov  ecx, 64       ; max nodes
            .tick_loop:
                cmp  dword [edi + OMEGA_OFF_STATE], STATE_EXECUTED
                jge  .tick_next
                cmp  dword [edi + OMEGA_OFF_TYPE], 0
                je   .tick_next
                ; Advance state by one step
                inc  dword [edi + OMEGA_OFF_STATE]
            .tick_next:
                add  edi, OMEGA_SIZE
                loop .tick_loop
            ret
    end
end

# ============================================================================
# SELF-COMPILATION LOOP
# ============================================================================
#
# This is the final definition. The system compiles itself.
# input  = this file (hdgl_firmware.hdgl)
# output = hdgl_firmware_v2.hdgl
# The compiler is written in the language it compiles.
#

self_compile_loop
    input   = hdgl_firmware.hdgl
    output  = hdgl_firmware_v2.hdgl

    entry compile_hdgl_firmware
        phase self_hosting
            execute compiler
                input  = hdgl_firmware.hdgl
                output = hdgl_firmware_v2.hdgl
            end
        end
    end

end

# ============================================================================
# DISK LAYOUT
# ============================================================================
#
# The image layout is itself a glyph.
# No Makefile. No build script. Only: this definition.
#

glyph disk_image
    id          = DISK_IMAGE
    class       = STORAGE
    state       = CONFIGURED

    region boot_stub
        sectors = 0
        size    = 512
        source  = hdgl_boot.hdg emit rule emit_boot_stub
    end

    region runtime
        sectors = 1..16
        size    = 8192
        source  = hdgl_firmware.hdgl emit rules emit_*
    end

    region padding
        sectors = 17
        size    = 512
        fill    = 0x00
    end

    region source
        sectors = 18..21
        size    = 2048
        source  = hdgl_firmware.hdgl raw
        # The source IS embedded in the image.
        # The running system can read itself.
        # This is the self-defining property.
    end

end

# ============================================================================
# END OF HDGL FIRMWARE
# ============================================================================
#
# This file is the firmware.
# It defines itself by defining everything in it.
# The compiler that compiles it is inside it (glyph compiler).
# The runtime that runs it is inside it (glyph rewrite_engine).
# The disk image that contains it is inside it (glyph disk_image).
#
# Fixed point:
#   hdgl_firmware.hdgl compiled by hdgl_firmware.hdgl
#   produces hdgl_firmware.bin
#   which when run executes hdgl_firmware.hdgl
#   which produces hdgl_firmware_v2.hdgl
#   which is hdgl_firmware.hdgl (self-hosting complete)
#
# Ω(n+1) = T(Ω(n))
# ============================================================================
